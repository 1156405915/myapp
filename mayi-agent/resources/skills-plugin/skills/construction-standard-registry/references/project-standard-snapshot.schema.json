{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mayi Project Standard Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "projectId",
    "sessionId",
    "applicableDate",
    "mode",
    "revision",
    "standards",
    "generatedAt",
    "snapshotHash",
    "artifactRelativePath"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "snapshotId": { "type": "string", "format": "uuid" },
    "projectId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "applicableDate": { "type": "string", "format": "date" },
    "mode": { "enum": ["draft", "formal"] },
    "revision": { "type": "integer", "minimum": 1 },
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "title",
          "versionId",
          "sourceHash",
          "selectionReason",
          "verificationStatus",
          "verifiedAt"
        ],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "versionId": { "type": "string", "format": "uuid" },
          "sourceHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "selectionReason": {
            "enum": ["tender", "design", "mandatory", "regional", "method"]
          },
          "verificationStatus": { "type": "string", "minLength": 1 },
          "verifiedAt": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "generatedAt": { "type": "integer", "minimum": 0 },
    "snapshotHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifactRelativePath": { "type": "string", "minLength": 1 }
  }
}
