{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mayi Municipal Method Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "version", "name", "discipline", "tags",
    "applicableFactIds", "excludedFactIds", "requiredFactIds", "workflow",
    "controlPoints", "laborRoles", "equipmentTypes", "qualityEvidence",
    "safetyRisks", "environmentalControls", "sourceRefs",
    "prohibitedAssumptions", "reviewStatus"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "discipline": { "enum": ["road", "drainage", "utility", "traffic", "lighting", "landscape", "common"] },
    "tags": { "$ref": "#/$defs/stringList" },
    "applicableFactIds": { "$ref": "#/$defs/stringList" },
    "excludedFactIds": { "$ref": "#/$defs/stringList" },
    "requiredFactIds": { "$ref": "#/$defs/stringList" },
    "workflow": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name"],
        "properties": { "id": { "type": "string" }, "name": { "type": "string" } }
      }
    },
    "controlPoints": { "type": "array", "maxItems": 100 },
    "laborRoles": { "$ref": "#/$defs/stringList" },
    "equipmentTypes": { "$ref": "#/$defs/stringList" },
    "qualityEvidence": { "$ref": "#/$defs/stringList" },
    "safetyRisks": { "$ref": "#/$defs/stringList" },
    "environmentalControls": { "$ref": "#/$defs/stringList" },
    "sourceRefs": { "type": "array", "maxItems": 50 },
    "prohibitedAssumptions": { "$ref": "#/$defs/stringList" },
    "reviewStatus": { "enum": ["draft", "reviewed", "approved", "retired", "rejected"] },
    "reviewedAt": { "type": "string", "format": "date" }
  },
  "$defs": {
    "stringList": {
      "type": "array", "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    }
  }
}
