PORT=3000

# DeepSeek through the Anthropic-compatible endpoint
AI_DEEPSEEK_KEY=
AI_DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
AI_DEEPSEEK_MODEL=deepseek-v4-pro
AI_AGENT_MAX_TURNS=8
AI_AGENT_TIMEOUT_MS=180000

# Existing database configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=test

# Optional SSH tunnel
SSH_HOST=
SSH_PORT=22
SSH_USER=ubuntu
SSH_PASSWORD=
SSH_PRIVATE_KEY=
SSH_PRIVATE_KEY_PATH=
