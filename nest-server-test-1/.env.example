# Direct mode: set MYSQL_HOST to the public MySQL host or mapped port host.
# SSH tunnel mode: set MYSQL_HOST to the hostname visible from the remote server, for example db.
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=myapp
MYSQL_PASSWORD=ZDS901029abc
MYSQL_DATABASE=myapp
MYSQL_CONNECTION_LIMIT=10
MYSQL_CONNECT_TIMEOUT=10000

# Set to true when MySQL should be reached through an SSH tunnel instead of a public port.
MYSQL_SSH_ENABLED=true
MYSQL_SSH_HOST=47.101.53.36
MYSQL_SSH_PORT=22
MYSQL_SSH_USERNAME=root
MYSQL_SSH_PASSWORD=ZDS901029abc
MYSQL_SSH_PRIVATE_KEY_PATH=
MYSQL_SSH_PRIVATE_KEY=
MYSQL_SSH_PRIVATE_KEY_PASSPHRASE=
MYSQL_SSH_DST_HOST=db
MYSQL_SSH_DST_PORT=3306
MYSQL_SSH_LOCAL_HOST=127.0.0.1
MYSQL_SSH_LOCAL_PORT=3307
MYSQL_SSH_READY_TIMEOUT=10000
